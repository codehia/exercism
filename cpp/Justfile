# Build and test an exercise: just build lasagna
build exercise:
    cmake -S {{exercise}} -B {{exercise}}/build -G "Unix Makefiles" -DEXERCISM_RUN_ALL_TESTS=1
    make -C {{exercise}}/build

[no-cd]
make:
    mkdir -p build
    cd build && cmake -G "Unix Makefiles" -DEXERCISM_RUN_ALL_TESTS=1 .. && make
